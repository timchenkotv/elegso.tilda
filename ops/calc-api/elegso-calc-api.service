[Unit]
Description=ELEGSO calculator API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=elegso_api
Group=elegso_api
ExecStart=/usr/bin/python3 /opt/elegso-calc-api/server.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
