# OAuth secrets are loaded only by the short-lived synchronization service.
# Keep /etc/elegso-seo-admin/yandex.env owned by root with mode 0600.
# One shared token may be used when it has access to both services, or use the
# two narrower variables below.
YANDEX_ANALYTICS_OAUTH_TOKEN=
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_WEBMASTER_OAUTH_TOKEN=
