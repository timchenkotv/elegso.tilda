[Unit]
Description=Collect multi-site SEO positions from the official Yandex Search API
Documentation=https://aistudio.yandex.ru/ru/docs/search-api/concepts/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=seo-monitor
Group=seo-monitor
UMask=0027
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Moscow
EnvironmentFile=/etc/elegso-seo-monitor/seo-monitor.env
StateDirectory=elegso-seo-monitor
StateDirectoryMode=0750
RuntimeDirectory=elegso-seo-monitor
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock --nonblock /run/elegso-seo-monitor/run.lock /usr/bin/python3 /opt/elegso-seo-monitor/seo_monitor.py run --config /etc/elegso-seo-monitor/keywords.json --db /var/lib/elegso-seo-monitor/history.sqlite3 --report-dir /var/lib/elegso-seo-monitor/reports
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

