[Unit]
Description=Resume ELEGSO Wordstat discovery within the rolling quota
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=seo-monitor
Group=seo-monitor
UMask=0027
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Moscow
EnvironmentFile=/etc/elegso-seo-monitor/seo-monitor.env
ExecStart=/usr/bin/flock --conflict-exit-code 75 --nonblock /var/lib/elegso-seo-monitor/network.lock /usr/bin/python3 /opt/elegso-seo-monitor/seo_monitor.py work-wordstat --config /var/lib/elegso-seo-admin/config/keywords.json --db /var/lib/elegso-seo-monitor/history.sqlite3 --hourly-limit 90 --batch-size 90
SuccessExitStatus=75
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/var/lib/elegso-seo-admin/config
ReadWritePaths=/var/lib/elegso-seo-monitor
