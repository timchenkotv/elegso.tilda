# Copy to /etc/elegso-seo-monitor/seo-monitor.env, set mode 0600 and fill in
# the real values. Never commit that production file or paste its contents into
# issue trackers and logs.
# Optional for a service-account API key: Search API infers its folder.
# Required when YANDEX_IAM_TOKEN is used instead.
YANDEX_FOLDER_ID=
YANDEX_SEARCH_API_KEY=replace-with-secret-api-key

# As an alternative to an API key, leave YANDEX_SEARCH_API_KEY empty and set a
# short-lived IAM token. Never set both variables at once.
YANDEX_IAM_TOKEN=

# Public Moscow egress address passed to the official API as
# metadata.fields.X-Forwarded-For-Y. It is not used to scrape search pages.
YANDEX_SEARCH_GEO_IP=155.212.215.203

# Async operations normally take at least several minutes. Values below are
# intentionally conservative for the nightly service.
SEO_MONITOR_POLL_INTERVAL=60
SEO_MONITOR_POLL_TIMEOUT=10800
SEO_MONITOR_HTTP_TIMEOUT=30
SEO_MONITOR_HTTP_RETRIES=5
SEO_MONITOR_MIN_REQUEST_INTERVAL=0.15

# Optional path overrides. The systemd unit already passes these explicitly.
# SEO_MONITOR_CONFIG=/etc/elegso-seo-monitor/keywords.json
# SEO_MONITOR_DB=/var/lib/elegso-seo-monitor/history.sqlite3
# SEO_MONITOR_REPORT_DIR=/var/lib/elegso-seo-monitor/reports
